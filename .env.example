# Copy to .env; never commit real credentials. The program reads process environment,
# not .env automatically. Docker Compose reads this file after copying to .env;
# make run-portal passes it to the portal's PORTAL_-only loader.
# Local host ports. Containers still listen on their original internal ports.
BROKER_PORT=18082
PF_ADMIN_PORT=9999
PF_RUNTIME_PORT=9031
PORTAL_PORT=8788
# Ping Identity image access is supplied through your licensed DevOps account.
PING_IDENTITY_DEVOPS_USER=REPLACE_ME
PING_IDENTITY_DEVOPS_KEY=REPLACE_ME
PINGFEDERATE_IMAGE_TAG=edge
LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=./data
# Generate once: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

PF_ISSUER=https://localhost:9031
PF_INTROSPECTION_URL=https://localhost:9031/as/introspect.oauth2
PF_INTROSPECTION_CLIENT_ID=directory-broker-rs
PF_INTROSPECTION_CLIENT_SECRET=REPLACE_ME
BROKER_AUDIENCE=https://directory-broker.example.com
BROKER_LOG_LEVEL=info
PF_PORTAL_CLIENT_IDS=directory-portal
PF_AGENT_CLIENT_IDS=directory-agent

# Local HTTPS portal (make run-portal). Fill the secret and PF journey URL
# after configuring the PF client and Agentless handoff. Do not commit .env.
PORTAL_PUBLIC_URL=https://localhost:8788
PORTAL_LISTEN_ADDR=127.0.0.1:8788
PORTAL_LOG_LEVEL=info
PORTAL_TLS_CERT_FILE=certs/portal.pem
PORTAL_TLS_KEY_FILE=certs/portal-key.pem
PORTAL_PF_URL=https://localhost:9031
# Optional public PF runtime for browser redirects; backend token exchange still uses PORTAL_PF_URL.
# PORTAL_PF_BROWSER_URL=https://ping.entraid.darkedges.com
PORTAL_PF_CLIENT_ID=directory-portal
PORTAL_PF_CLIENT_SECRET=
PORTAL_AGENT_CLIENT_ID=directory-agent
PORTAL_AGENT_CLIENT_SECRET=
PORTAL_BROKER_URL=http://127.0.0.1:18082
PORTAL_PF_CONNECT_START_URL=
PORTAL_REFERENCE_SUBJECT=
PORTAL_SAML_SUBJECT=
PORTAL_SAML_CONNECT_ENABLED=false

PF_PICKUP_URL=https://localhost:9031/ext/ref/pickup
PF_SP_ADAPTER_ID=graphDirectoryLink
PF_PICKUP_USER=directory-broker-pickup
PF_PICKUP_PASSWORD=REPLACE_ME

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# MUST be the app registration used by the upstream PF Entra OIDC connection.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=REPLACE_ME

# Optional, one-user SAML1.1 -> custom API -> Graph OBO path. Keep disabled
# until the local PF exchange policy accepts this portal's reference access
# token and Entra trusts its signed SAML assertion. Rotate exposed secrets.
SAML_ENABLED=false
SAML_PF_TOKEN_URL=
SAML_PF_CLIENT_ID=
SAML_PF_CLIENT_SECRET=
SAML_ENTRA_TENANT_ID=
SAML_ENTRA_CLIENT_ID=
SAML_ENTRA_CLIENT_SECRET=
SAML_ENTRA_SCOPE=
SAML_OBO_CLIENT_ID=
SAML_OBO_CLIENT_SECRET=
SAML_EXPECTED_PF_SUBJECT=
SAML_EXPECTED_ENTRA_OID=
